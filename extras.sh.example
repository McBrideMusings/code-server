#!/usr/bin/env bash
# Copy this file to extras.sh (gitignored) and add your own build steps.
# extras.sh runs at the end of the Docker build as root inside the image.
#
# List local source directories in SOURCES — build.sh copies them into
# /tmp/tools/<dirname>/ before the build so they're available here.
#
# SOURCES=(
#   /path/to/your/tool
# )
#
# -- Go binary --
#
# cd /tmp/tools/mytool && go build -o /usr/local/bin/mytool .
#
# -- Go binary with shell init (e.g. needs eval for cd support) --
#
# cd /tmp/tools/mytool && go build -o /usr/local/bin/mytool ./cmd/mytool
# echo 'eval "$(mytool init)"' >> /etc/container-bashrc
#
# -- Python library installed system-wide --
#
# mkdir -p /usr/local/mylib
# cp -R /tmp/tools/mylib/src /usr/local/mylib/
# cp /tmp/tools/mylib/entrypoint /usr/local/mylib/
# chmod +x /usr/local/mylib/entrypoint
# echo 'export PATH="/usr/local/mylib:$PATH"' >> /etc/container-bashrc
